# ── LLM provider ──────────────────────────────────────────────────────────────
# Choose "gemini" or "openrouter"
LLM_PROVIDER=gemini

# ── Gemini ────────────────────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here

# ── OpenRouter ────────────────────────────────────────────────────────────────
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Model to use — see https://openrouter.ai/models for options
OPENROUTER_MODEL=openrouter/free

# ── LM Studio (local) ─────────────────────────────────────────────────────────
# Start the local server in LM Studio, then load any model.
# Recommended for low-latency cleanup: qwen2.5-1.5b-instruct (~1 GB)
LMSTUDIO_URL=http://localhost:1234/v1
LMSTUDIO_MODEL=qwen2.5-3b-instruct
LMSTUDIO_API_KEY=

# ── Ollama (local) ────────────────────────────────────────────────────────────
# Install Ollama, then: ollama pull qwen2.5:1.5b
# Recommended for low-latency cleanup: qwen2.5:1.5b (~1 GB)
OLLAMA_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5:1.5b
